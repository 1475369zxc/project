{% extends '@!EasyAdmin/crud/edit.html.twig' %}

{% block main %}
    <div class="row">
        <div class="col-md-8">
            {{ parent() }}
        </div>
        <div class="col-md-4">
            {% if entity.instance.photo %}
                <div class="card">
                    <div class="card-body text-center">
                        <a href="{{ entity.instance.photo }}" target="_blank">
                            <img src="{{ entity.instance.photo }}"
                                 alt="Photo"
                                 style="max-width: 100%; max-height: 400px; border-radius: 8px; border: 2px solid #dee2e6;">
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="card">
                    <div class="card-body text-center text-muted">
                        <img src="{{ default_user_photo }}"
                             alt="The photo was not uploaded"
                             style="max-width: 100%; max-height: 400px; border-radius: 5px; ">
                        <p class="text-muted mt-2 mb-0">The photo was not uploaded</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
