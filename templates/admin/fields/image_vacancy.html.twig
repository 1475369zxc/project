{% if field.value %}
  <a href="{{ field.value }}" target="_blank">
    <img
      src="{{ field.value }}"
      alt="Photo"
      style="width: 50px; height: 50px; border-radius: 50px; object-fit: cover; border: 2px solid #dee2e6;">
  </a>
{% else %}
  <img
    src="{{ default_vacancy_photo }}"
    alt="The photo was not uploaded"
    style="width: 50px; height: 50px; border-radius: 50px; object-fit: cover; border: 2px solid #dee2e6;">
{% endif %}
