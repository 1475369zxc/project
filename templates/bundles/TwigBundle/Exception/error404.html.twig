{% extends 'base.html.twig' %}

{% block title %}Страница не найдена{% endblock %}

{% block body %}

    <section class="h-100vh pt-5">
        <div class="home-center">
            <div class="home-desc-center">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-8">
                            <article class="post">
                                <div class="container text-center py-5">
                                    <h1 class="display-1">404</h1>
                                    <h2 class="mb-4">The page was not found</h2>
                                    <p class="text-muted mb-4">
                                        Unfortunately, the page you are looking for does not exist or has been moved.
                                    </p>
                                    <a href="{{ path('homepage') }}" class="btn btn-primary">
                                        <i class="mdi mdi-home"></i> Go to the main page
                                    </a>
                                </div>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
